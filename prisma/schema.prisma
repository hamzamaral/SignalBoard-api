generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ListingSource {
  ILAN_GOV
  KAMUILAN
  KARIYER_KAPISI
  ISKUR
  RESMI_GAZETE
  YEREL_YONETIMLER
  MANUAL
  PRIVATE
  CSV
}

enum ListingKind {
  PUBLIC
  PRIVATE
}

enum ListingStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum PipelineStatus {
  NEW
  REVIEW
  TO_APPLY
  APPLIED
  WAITING_RESULT
  CLOSED
  CANNOT_APPLY
}

enum LlmProvider {
  NONE
  OLLAMA
  GEMINI
  GROQ
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         Role      @default(USER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  profile       UserProfile?
  userListings  UserListing[]
  alertRules    AlertRule[]
  reminders     Reminder[]
  notifications NotificationOutbox[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  nameNorm  String   @map("name_norm")
  city      String?
  kind      String? // university, ministry, municipality, institute, other
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  aliases  InstitutionAlias[]
  listings Listing[]

  @@unique([nameNorm])
  @@index([name])
  @@map("institutions")
}

model InstitutionAlias {
  id            String @id @default(uuid()) @db.Uuid
  institutionId String @map("institution_id") @db.Uuid
  alias         String
  aliasNorm     String @map("alias_norm")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([aliasNorm])
  @@index([institutionId])
  @@map("institution_aliases")
}

model Listing {
  id                    String        @id @default(uuid()) @db.Uuid
  institutionId         String?       @map("institution_id") @db.Uuid
  kind                  ListingKind   @default(PUBLIC)
  source                ListingSource @default(MANUAL)
  status                ListingStatus @default(OPEN)
  title                 String
  titleNorm             String        @map("title_norm")
  position              String?
  positionNorm          String?       @map("position_norm")
  description           String?       @db.Text
  rawText               String?       @map("raw_text") @db.Text
  url                   String?
  city                  String?
  educationLevel        String?       @map("education_level")
  kpssScoreType         String?       @map("kpss_score_type")
  kpssMinScore          Decimal?      @map("kpss_min_score") @db.Decimal(6, 3)
  quota                 Int?
  publishedAt           DateTime?     @map("published_at")
  applyStartAt          DateTime?     @map("apply_start_at")
  applyEndAt            DateTime?     @map("apply_end_at")
  resultAt              DateTime?     @map("result_at")
  examAt                DateTime?     @map("exam_at")
  resultAnnounceAt      DateTime?     @map("result_announce_at")
  applicationPlace      String?       @map("application_place") @db.Text
  applicationMethods    String[]      @default([]) @map("application_methods")
  requiredDocuments     String[]      @default([]) @map("required_documents")
  generalRequirements   String?       @map("general_requirements") @db.Text
  specialRequirements   String?       @map("special_requirements") @db.Text
  examTopics            String?       @map("exam_topics") @db.Text
  evaluationNotes       String?       @map("evaluation_notes") @db.Text
  externalKey           String?       @map("external_key")
  fingerprint           String
  listingGroupId        String?       @map("listing_group_id") @db.Uuid
  version               Int           @default(1)
  possibleDup           Boolean       @default(false) @map("possible_dup")
  requiredSkills        String[]      @default([]) @map("required_skills")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  institution  Institution?       @relation(fields: [institutionId], references: [id])
  positions    ListingPosition[]
  revisions    ListingRevision[]
  userListings UserListing[]
  reminders    Reminder[]

  @@unique([source, externalKey])
  @@unique([fingerprint])
  @@index([kind, status])
  @@index([applyEndAt])
  @@index([institutionId])
  @@map("listings")
}

model ListingPosition {
  id                    String   @id @default(uuid()) @db.Uuid
  listingId             String   @map("listing_id") @db.Uuid
  sequenceNo            Int      @default(1) @map("sequence_no")
  title                 String
  titleNorm             String   @map("title_norm")
  serviceClass          String?  @map("service_class")
  grade                 Int?
  quota                 Int?
  educationRequirement  String?  @map("education_requirement") @db.Text
  gender                String?
  kpssScoreType         String?  @map("kpss_score_type")
  kpssMinScore          Decimal? @map("kpss_min_score") @db.Decimal(6, 3)
  skillsTags            String[] @default([]) @map("skills_tags")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  listing      Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userListings UserListing[]

  @@index([listingId])
  @@index([titleNorm])
  @@map("listing_positions")
}

model ListingRevision {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  version   Int
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, version])
  @@map("listing_revisions")
}

model UserProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  education     String?
  preferredCity String?  @map("preferred_city")
  kpssScores    Json     @default("{}") @map("kpss_scores")
  certificates  String[] @default([])
  skills        String[] @default([])
  targetTitles  String[] @default([]) @map("target_titles")
  emailAlerts   Boolean  @default(true) @map("email_alerts")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserListing {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  listingId   String         @map("listing_id") @db.Uuid
  positionId  String?        @map("position_id") @db.Uuid
  status      PipelineStatus @default(NEW)
  notes       String?
  matchScore  Int?           @map("match_score")
  updatedFlag Boolean        @default(false) @map("updated_flag")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing  Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position ListingPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@unique([userId, listingId])
  @@index([userId, status])
  @@map("user_listings")
}

model AlertRule {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  keywords  String[] @default([])
  cities    String[] @default([])
  sources   ListingSource[] @default([])
  minScore  Int?     @map("min_score")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("alert_rules")
}

model Reminder {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  listingId   String?  @map("listing_id") @db.Uuid
  title       String
  remindAt    DateTime @map("remind_at")
  note        String?
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([userId, remindAt])
  @@map("reminders")
}

model NotificationOutbox {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel @default(EMAIL)
  status    NotificationStatus  @default(PENDING)
  subject   String
  body      String              @db.Text
  meta      Json?
  sentAt    DateTime?           @map("sent_at")
  error     String?
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("notification_outbox")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
