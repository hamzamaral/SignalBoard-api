NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://signalboard:signalboard@localhost:5432/signalboard?schema=public
# Local tip: if 5432 busy, map compose POSTGRES_PORT=5433 and use localhost:5433
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
LOG_LEVEL=info
SEED_ON_EMPTY=true
SETTINGS_ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase!
OLLAMA_BASE_URL=http://127.0.0.1:11434
